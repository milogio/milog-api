APP_NAME=MiLog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

MILOG_UI_ACCESS_TOKEN_MINUTES=15
MILOG_UI_REFRESH_TOKEN_DAYS=30
MILOG_UI_URL=http://localhost:3000
MILOG_SIGNUP_VERIFICATION_HOURS=24
MILOG_TRIAL_DAYS=14
MILOG_TEMPORARY_KEY_DAYS=7
MILOG_TEMPORARY_KEY_LIMIT=2
MILOG_PAID_KEY_LIMIT=5

LOG_CHANNEL=stack

MILOG_FRONTEND_ENABLED=false
MILOG_FRONTEND_DISABLED_STATUS=404
MILOG_FRONTEND_LOG_CHANNEL="${LOG_CHANNEL}"

DB_CONNECTION=pgsql
DB_HOST=milog-postgres
DB_PORT=5432
DB_DATABASE=milog
DB_USERNAME=milog
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=milog-mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@milog.test
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
