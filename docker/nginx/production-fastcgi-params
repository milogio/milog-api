# The only public entry point is host Caddy. Pass a small, explicit request
# header set to PHP, and give Laravel one fixed proxy address to trust.
fastcgi_pass_request_headers off;
fastcgi_param QUERY_STRING $query_string;
fastcgi_param REQUEST_METHOD $request_method;
fastcgi_param CONTENT_TYPE $content_type;
fastcgi_param CONTENT_LENGTH $content_length;
fastcgi_param SCRIPT_NAME $fastcgi_script_name;
fastcgi_param REQUEST_URI $request_uri;
fastcgi_param DOCUMENT_URI $document_uri;
fastcgi_param DOCUMENT_ROOT $document_root;
fastcgi_param SERVER_PROTOCOL $server_protocol;
fastcgi_param REQUEST_SCHEME $scheme;
fastcgi_param GATEWAY_INTERFACE CGI/1.1;
fastcgi_param SERVER_SOFTWARE nginx/$nginx_version;
fastcgi_param REMOTE_ADDR 127.0.0.1;
fastcgi_param REMOTE_PORT $remote_port;
fastcgi_param SERVER_ADDR $server_addr;
fastcgi_param SERVER_PORT $server_port;
fastcgi_param SERVER_NAME api.milog.ca;
fastcgi_param REDIRECT_STATUS 200;
fastcgi_param HTTP_HOST api.milog.ca;
fastcgi_param HTTP_ACCEPT $http_accept;
fastcgi_param HTTP_AUTHORIZATION $http_authorization;
fastcgi_param HTTP_X_API_KEY $http_x_api_key if_not_empty;
fastcgi_param HTTP_X_IDEMPOTENCY_KEY $http_x_idempotency_key;
fastcgi_param HTTP_X_REQUESTED_WITH $http_x_requested_with;
fastcgi_param HTTP_X_FORWARDED_FOR $http_x_forwarded_for;
fastcgi_param HTTP_X_FORWARDED_HOST api.milog.ca;
fastcgi_param HTTP_X_FORWARDED_PROTO https;
fastcgi_param HTTP_X_FORWARDED_PORT 443;
