MILOG_PHP_IMAGE=registry.example.com/milog-api/php:release-sha
MILOG_NGINX_IMAGE=registry.example.com/milog-api/nginx:release-sha
MILOG_HTTP_PORT=8080
MILOG_APP_KEY=base64:replace-with-a-generated-production-key
MILOG_DB_PASSWORD=replace-with-a-strong-production-password
MILOG_PASSPORT_PRIVATE_KEY_B64=base64-encoded-passport-private-key
MILOG_PASSPORT_PUBLIC_KEY_B64=base64-encoded-passport-public-key
MILOG_UI_ACCESS_TOKEN_MINUTES=15
MILOG_UI_REFRESH_TOKEN_DAYS=30
MILOG_UI_URL=https://app.example.com
MILOG_MAIL_HOST=smtp.example.com
MILOG_MAIL_PORT=587
MILOG_MAIL_ENCRYPTION=tls
MILOG_MAIL_USERNAME=replace-with-smtp-username
MILOG_MAIL_PASSWORD=replace-with-smtp-password
MILOG_MAIL_FROM_ADDRESS=verify@example.com
